[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE Branches %]
[% USE Categories %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% SET libraries = Branches.all %]
[% SET categories = Categories.all.unblessed %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% FILTER collapse %]
    [% t("Patron search") | html %] &rsaquo; [% t("Patrons") | html %] &rsaquo; [% t("Koha") | html %]
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="pat_patron_search" class="pat">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'patron-search-header.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            <span>[% t("Patrons") | html %]</span>
        [% END %]
    [% END %]
[% END %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-2 order-md-1 order-sm-2" id="facets-container">
            <div id="facets" class="sidebar" style="display:none;">
                <h4>[% t("Refine search") | html %]</h4>
                <p><a href="#" id="clear-facets" class="btn btn-link btn-sm"><i class="fa fa-times"></i> [% t("Clear all filters") | html %]</a></p>
                <div id="facet-library_id"></div>
                <div id="facet-category_id"></div>
            </div>
        </div>

        <div class="col-md-10 order-md-2 order-sm-1">
            <main>
                [% INCLUDE 'patron-toolbar.inc' %]

                <form id="patron-search-form" class="form-inline" style="margin: 1em 0;">
                    <div class="form-group">
                        <label for="search-query" class="sr-only">[% t("Search") | html %]:</label>
                        <input type="text" id="search-query" class="form-control" placeholder="[% t("Name, cardnumber, email...") | html %]" autofocus style="width: 400px;" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> [% t("Search") | html %]</button>
                    <a href="#" id="toggle-advanced" class="btn btn-link btn-sm"><i class="fa fa-sliders"></i> [% t("Advanced") | html %]</a>

                    <div id="advanced-search-panel" style="display:none; margin-top: 0.5em;" class="form-inline">
                        <div class="form-group me-2">
                            <label for="search-field" class="me-1">[% t("Search field") | html %]:</label>
                            <select id="search-field" class="form-select form-select-sm">
                                <option value="">[% t("All fields") | html %]</option>
                                <option value="surname">[% t("Surname") | html %]</option>
                                <option value="firstname">[% t("First name") | html %]</option>
                                <option value="cardnumber">[% t("Card number") | html %]</option>
                                <option value="email">[% t("All emails") | html %]</option>
                                <option value="phone|mobile">[% t("All phones") | html %]</option>
                                <option value="address|city|postal_code">[% t("Full address") | html %]</option>
                                <option value="date_of_birth">[% t("Date of birth") | html %]</option>
                                <option value="patron_id">[% t("Patron ID") | html %]</option>
                                [% IF Koha.Preference('ExtendedPatronAttributes') %]
                                    [% FOREACH attribute IN ExtendedAttributeTypes.all( staff_searchable => 1 ) %]
                                        <option value="ext_attr_[% attribute.code | html %]">[% attribute.description | html %]</option>
                                    [% END %]
                                [% END %]
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="search-type" class="me-1">[% t("Search type") | html %]:</label>
                            <select id="search-type" class="form-select form-select-sm">
                                <option value="starts_with">[% t("Starts with") | html %]</option>
                                <option value="contains" selected>[% t("Contains") | html %]</option>
                            </select>
                        </div>
                    </div>
                </form>

                <div id="active-filters" style="display:none; margin-bottom: 1em;">
                    <span class="label">[% t("Active filters:") | html %]</span>
                    <span id="active-filters-list"></span>
                </div>

                <table id="patron-search-table" class="table table-striped" style="display:none;">
                    <thead>
                        <tr>
                            <th>[% t("Card number") | html %]</th>
                            <th>[% t("Name") | html %]</th>
                            <th>[% t("Phone") | html %]</th>
                            <th>[% t("Date of birth") | html %]</th>
                            <th>[% t("Library") | html %]</th>
                            <th>[% t("Category") | html %]</th>
                            <th>[% t("Expires") | html %]</th>
                            <th>[% t("Checkouts") | html %]</th>
                            <th>[% t("Fines") | html %]</th>
                            <th>[% t("Notes") | html %]</th>
                            <th class="noExport">[% t("Actions") | html %]</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </main>
        </div>
    </div>
</div>

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'datatables.inc' %]
    <script>
        var defined_per_page = [% PatronsPerPage | html %];

        // Build lookup maps for descriptions
        var library_map = {
            [% FOREACH l IN libraries %]"[% l.branchcode | html %]": "[% l.branchname | html %]",[% END %]
        };
        var category_map = {
            [% FOREACH c IN categories %]"[% c.categorycode | html %]": "[% c.description | html %]",[% END %]
        };

        function describeValue(field, code) {
            if (field === "library_id") return library_map[code] || code;
            if (field === "category_id") return category_map[code] || code;
            return code;
        }

        $(document).ready(function() {
            var patron_table;
            var active_filters = {}; // { library_id: ["MPL","CPL"], category_id: ["PT"] }

            function doSearch() {
                var q = $("#search-query").val();

                $("#patron-search-table").show();

                if (patron_table) {
                    patron_table.DataTable().ajax.reload();
                } else {
                    patron_table = $("#patron-search-table").kohaTable({
                        ajax: {
                            url: "/api/v1/search/patrons",
                            dataSrc: function(json) {
                                renderFacets(json.facets);
                                return json.hits;
                            },
                            data: function(data, settings) {
                                var q = $("#search-query").val();
                                var params = {
                                    _page: Math.floor(data.start / data.length) + 1,
                                    _per_page: data.length,
                                };
                                if (q) params.q = q;

                                // Advanced: specific field
                                var field = $("#search-field").val();
                                if (field) {
                                    params.fields = field;
                                }

                                // Advanced: search type (starts_with handled server-side via prefix)
                                var searchType = $("#search-type").val();
                                if (searchType) {
                                    params._match = searchType;
                                }

                                // Sort
                                if (data.order && data.order.length) {
                                    var columns = ["cardnumber", "surname", "phone", "date_of_birth", "library_id", "category_id", "expiry_date", "checkouts_count", "account_balance", "staff_notes"];
                                    params._order_by = data.order.map(function(e) {
                                        var col = columns[e.column] || "surname";
                                        var dir = e.dir === "asc" ? "+" : "-";
                                        return dir + col;
                                    }).join(",");
                                }

                                // Active filters
                                if (Object.keys(active_filters).length) {
                                    params.filters = JSON.stringify(active_filters);
                                }

                                return params;
                            },
                            dataFilter: function(data, type) {
                                var json = JSON.parse(data);
                                json.recordsTotal = json.total;
                                json.recordsFiltered = json.total;
                                return JSON.stringify(json);
                            }
                        },
                        columns: [
                            {
                                data: "cardnumber",
                                render: function(data, type, row) {
                                    return '<a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=' + row.patron_id + '">' + (data || '') + '</a>';
                                }
                            },
                            {
                                data: "surname",
                                render: function(data, type, row) {
                                    var name = (row.surname || '') + ', ' + (row.firstname || '');
                                    var address = [row.address, row.city, row.postal_code].filter(Boolean).join(', ');
                                    var html = '<a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=' + row.patron_id + '" class="patron_name">' + name + '</a>';
                                    if (address) html += '<br/><span class="text-muted">' + address + '</span>';
                                    return html;
                                }
                            },
                            { data: "phone", defaultContent: "" },
                            { data: "date_of_birth", defaultContent: "" },
                            { data: "library_id", render: function(data) { return library_map[data] || data || ''; } },
                            { data: "category_id", render: function(data) { return category_map[data] || data || ''; } },
                            { data: "expiry_date", defaultContent: "" },
                            { data: "checkouts_count", defaultContent: "0" },
                            {
                                data: "account_balance",
                                render: function(data) {
                                    if (!data || data == 0) return "0.00";
                                    var cls = data > 0 ? "text-danger" : "";
                                    return '<span class="' + cls + '">' + parseFloat(data).toFixed(2) + '</span>';
                                }
                            },
                            { data: "staff_notes", defaultContent: "" },
                            {
                                data: "patron_id",
                                searchable: false,
                                orderable: false,
                                render: function(data, type, row) {
                                    var html = '';
                                    [% IF CAN_user_borrowers_edit_borrowers %]
                                    html += '<a href="/cgi-bin/koha/members/memberentry.pl?op=edit_form&amp;destination=circ&amp;borrowernumber=' + data + '" class="btn btn-default btn-xs"><i class="fa-solid fa-pencil" aria-hidden="true"></i> ' + __("Edit") + '</a> ';
                                    [% END %]
                                    [% IF CAN_user_circulate_circulate_remaining_permissions %]
                                    html += '<a href="/cgi-bin/koha/circ/circulation.pl?borrowernumber=' + data + '" class="btn btn-default btn-xs"><i class="fa fa-barcode"></i> ' + __("Check out") + '</a>';
                                    [% END %]
                                    return html;
                                }
                            }
                        ],
                        order: [[1, "asc"]],
                        pageLength: defined_per_page,
                    });
                }
            }

            function renderFacets(facets) {
                if (!facets) return;
                var hasFacets = false;

                // Library facet
                var html = '';
                if (facets.library_id && facets.library_id.length) {
                    hasFacets = true;
                    html = '<h5>' + __("Library") + '</h5><ul class="list-unstyled">';
                    facets.library_id.forEach(function(f) {
                        var selected = active_filters.library_id && active_filters.library_id.indexOf(f.value) >= 0;
                        var label = describeValue('library_id', f.value);
                        var cls = selected ? 'fw-bold' : '';
                        var x = selected ? ' <a href="#" class="facet-link text-danger" data-field="library_id" data-value="' + f.value + '">&times;</a>' : '';
                        html += '<li><a href="#" class="facet-link ' + cls + '" data-field="library_id" data-value="' + f.value + '">' + label + '</a> <span class="badge">' + f.count + '</span>' + x + '</li>';
                    });
                    html += '</ul>';
                }
                $("#facet-library_id").html(html);

                // Category facet
                html = '';
                if (facets.category_id && facets.category_id.length) {
                    hasFacets = true;
                    html = '<h5>' + __("Category") + '</h5><ul class="list-unstyled">';
                    facets.category_id.forEach(function(f) {
                        var selected = active_filters.category_id && active_filters.category_id.indexOf(f.value) >= 0;
                        var label = describeValue('category_id', f.value);
                        var cls = selected ? 'fw-bold' : '';
                        var x = selected ? ' <a href="#" class="facet-link text-danger" data-field="category_id" data-value="' + f.value + '">&times;</a>' : '';
                        html += '<li><a href="#" class="facet-link ' + cls + '" data-field="category_id" data-value="' + f.value + '">' + label + '</a> <span class="badge">' + f.count + '</span>' + x + '</li>';
                    });
                    html += '</ul>';
                }
                $("#facet-category_id").html(html);

                if (hasFacets) {
                    $("#facets").show();
                }

                // Bind facet clicks
                $(".facet-link").off("click").on("click", function(e) {
                    e.preventDefault();
                    var field = $(this).data("field");
                    var value = $(this).data("value");
                    if (!active_filters[field]) {
                        active_filters[field] = [value];
                    } else {
                        var idx = active_filters[field].indexOf(value);
                        if (idx >= 0) {
                            active_filters[field].splice(idx, 1);
                            if (!active_filters[field].length) delete active_filters[field];
                        } else {
                            active_filters[field].push(value);
                        }
                    }
                    updateActiveFiltersDisplay();
                    patron_table.DataTable().ajax.reload();
                });
            }

            function updateActiveFiltersDisplay() {
                var keys = Object.keys(active_filters);
                if (keys.length) {
                    var html = '';
                    keys.forEach(function(k) {
                        active_filters[k].forEach(function(v) {
                            var label = describeValue(k, v);
                            html += '<span class="badge bg-primary me-1">' + label + ' <a href="#" class="remove-filter text-white" data-field="' + k + '" data-value="' + v + '">&times;</a></span>';
                        });
                    });
                    $("#active-filters-list").html(html);
                    $("#active-filters").show();

                    $(".remove-filter").on("click", function(e) {
                        e.preventDefault();
                        var field = $(this).data("field");
                        var value = $(this).data("value");
                        if (active_filters[field]) {
                            var idx = active_filters[field].indexOf(value);
                            if (idx >= 0) active_filters[field].splice(idx, 1);
                            if (!active_filters[field].length) delete active_filters[field];
                        }
                        updateActiveFiltersDisplay();
                        patron_table.DataTable().ajax.reload();
                    });
                } else {
                    $("#active-filters").hide();
                }
            }

            $("#clear-facets").on("click", function(e) {
                e.preventDefault();
                active_filters = {};
                updateActiveFiltersDisplay();
                if (patron_table) {
                    patron_table.DataTable().ajax.reload();
                }
            });

            $("#toggle-advanced").on("click", function(e) {
                e.preventDefault();
                $("#advanced-search-panel").toggle();
            });

            $("#patron-search-form").on("submit", function(e) {
                e.preventDefault();
                doSearch();
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
