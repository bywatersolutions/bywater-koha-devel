[Unit]
Description=Koha Plack server for %i
PartOf=koha@%i.target
Requires=koha-create-dirs@%i.service
After=koha@%i.target koha-create-dirs@%i.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=forking
User=%i-koha
Group=%i-koha
WorkingDirectory=/var/lib/koha/%i
Environment=KOHA_CONF=/etc/koha/sites/%i/koha-conf.xml
Environment=KOHA_HOME=/usr/share/koha
Environment=PERL5LIB=/usr/share/koha/lib
PIDFile=/run/koha/%i/plack.pid
ExecStartPre=+/usr/sbin/koha-generate-env plack %i
EnvironmentFile=-/run/koha/%i/plack.env
ExecStart=/usr/bin/starman \
    -M FindBin \
    --max-requests ${PLACK_MAX_REQUESTS} \
    --workers ${PLACK_WORKERS} \
    --user %i-koha --group %i-koha \
    --pid /run/koha/%i/plack.pid \
    --daemonize \
    --access-log /var/log/koha/%i/plack.log \
    --error-log /var/log/koha/%i/plack-error.log \
    -E ${PLACK_ENVIRONMENT} \
    --listen /run/koha/%i/plack.sock \
    ${PLACK_PSGIFILE}
ExecReload=/bin/kill -HUP $MAINPID
Slice=koha-%i.slice
LimitDATA=3G
MemoryHigh=85%
MemoryMax=88%
MemorySwapMax=512M
OOMPolicy=continue
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
# No NoNewPrivileges here, unlike the other units. The task scheduler
# ( tools/scheduler.pl ) queues reports with at, which is setuid and setgid
# daemon, and NoNewPrivileges makes the kernel ignore those bits. Every other
# setuid, setgid and file capability binary a Debian server usually carries is
# made inaccessible instead, so at is the only one plack can run. A package
# upgrade that replaces one of them drops its mask until plack restarts.
# SystemCallFilter=, RestrictSUIDSGID=, PrivateDevices=, ProtectKernel*= and
# the other settings that imply NoNewPrivileges break the scheduler the same way.
InaccessiblePaths=-/usr/bin/su
InaccessiblePaths=-/usr/bin/sudo
InaccessiblePaths=-/usr/bin/pkexec
InaccessiblePaths=-/usr/bin/mount
InaccessiblePaths=-/usr/bin/umount
InaccessiblePaths=-/usr/bin/passwd
InaccessiblePaths=-/usr/bin/chsh
InaccessiblePaths=-/usr/bin/chfn
InaccessiblePaths=-/usr/bin/gpasswd
InaccessiblePaths=-/usr/bin/newgrp
InaccessiblePaths=-/usr/bin/fusermount
InaccessiblePaths=-/usr/bin/fusermount3
InaccessiblePaths=-/usr/bin/newuidmap
InaccessiblePaths=-/usr/bin/newgidmap
InaccessiblePaths=-/usr/lib/openssh/ssh-keysign
InaccessiblePaths=-/usr/lib/dbus-1.0/dbus-daemon-launch-helper
InaccessiblePaths=-/usr/lib/polkit-1/polkit-agent-helper-1
InaccessiblePaths=-/usr/sbin/mount.nfs
InaccessiblePaths=-/usr/sbin/mount.cifs
InaccessiblePaths=-/usr/sbin/exim4
InaccessiblePaths=-/usr/sbin/pppd
InaccessiblePaths=-/usr/bin/crontab
InaccessiblePaths=-/usr/bin/chage
InaccessiblePaths=-/usr/bin/expiry
InaccessiblePaths=-/usr/bin/ssh-agent
InaccessiblePaths=-/usr/bin/wall
InaccessiblePaths=-/usr/bin/write.ul
InaccessiblePaths=-/usr/bin/dotlockfile
InaccessiblePaths=-/usr/bin/plocate
InaccessiblePaths=-/usr/bin/mlocate
InaccessiblePaths=-/usr/sbin/unix_chkpwd
InaccessiblePaths=-/usr/sbin/postdrop
InaccessiblePaths=-/usr/sbin/postqueue
InaccessiblePaths=-/usr/bin/ping
InaccessiblePaths=-/usr/bin/arping
InaccessiblePaths=-/usr/bin/clockdiff
InaccessiblePaths=-/usr/bin/mtr-packet
InaccessiblePaths=-/usr/bin/fping
Restart=always
RestartSec=5s

[Install]
WantedBy=koha@%i.target
